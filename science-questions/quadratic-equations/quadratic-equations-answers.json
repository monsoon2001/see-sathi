    {
      "questionId": "q1",
      "type": "single",
      "solutionSteps": [
        {
          "step": 1,
          "text": {
            "en": "We need two numbers whose product is $12$ and sum is $-7$: these are $-3$ and $-4$.",
            "ne": "गुणनफल $12$ र योगफल $-7$ हुने दुई संख्या चाहिन्छ: ती हुन् $-3$ र $-4$।"
          }
        },
        {
          "step": 2,
          "text": {
            "en": "$x^2 - 3x - 4x + 12 = 0 \\Rightarrow x(x-3) - 4(x-3) = 0 \\Rightarrow (x-3)(x-4) = 0$",
            "ne": "$x^2 - 3x - 4x + 12 = 0 \\Rightarrow x(x-3) - 4(x-3) = 0 \\Rightarrow (x-3)(x-4) = 0$"
          }
        },
        {
          "step": 3,
          "text": {
            "en": "So $x - 3 = 0$ or $x - 4 = 0$, giving $x = 3$ or $x = 4$.",
            "ne": "त्यसैले $x - 3 = 0$ वा $x - 4 = 0$, अर्थात् $x = 3$ वा $x = 4$।"
          }
        }
      ],
      "finalAnswer": {
        "en": "$x = 3, 4$",
        "ne": "$x = 3, 4$"
      },
      "marks": 3
    },
    {
      "questionId": "q2",
      "type": "single",
      "solutionSteps": [
        {
          "step": 1,
          "text": {
            "en": "Here $a = 3$, $b = 5$, $c = -2$.",
            "ne": "यहाँ $a = 3$, $b = 5$, $c = -2$।"
          }
        },
        {
          "step": 2,
          "text": {
            "en": "$x = \\dfrac{-5 \\pm \\sqrt{5^2 - 4(3)(-2)}}{2(3)} = \\dfrac{-5 \\pm \\sqrt{25 + 24}}{6} = \\dfrac{-5 \\pm \\sqrt{49}}{6} = \\dfrac{-5 \\pm 7}{6}$",
            "ne": "$x = \\dfrac{-5 \\pm \\sqrt{5^2 - 4(3)(-2)}}{2(3)} = \\dfrac{-5 \\pm \\sqrt{25 + 24}}{6} = \\dfrac{-5 \\pm \\sqrt{49}}{6} = \\dfrac{-5 \\pm 7}{6}$"
          }
        },
        {
          "step": 3,
          "text": {
            "en": "$x = \\dfrac{2}{6} = \\dfrac{1}{3}$ or $x = \\dfrac{-12}{6} = -2$",
            "ne": "$x = \\dfrac{2}{6} = \\dfrac{1}{3}$ वा $x = \\dfrac{-12}{6} = -2$"
          }
        }
      ],
      "finalAnswer": {
        "en": "$x = \\dfrac{1}{3}, -2$",
        "ne": "$x = \\dfrac{1}{3}, -2$"
      },
      "marks": 4
    },
    {
