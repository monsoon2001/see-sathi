            "ne": "$x=2$ जाँच्दा: $(2)^2 - 5(2) + 6 = 4 - 10 + 6 = 0$। $x=3$ जाँच्दा: $(3)^2 - 5(3) + 6 = 9 - 15 + 6 = 0$। दुवैले समीकरण सन्तुष्ट गर्छन्।"
          }
        }
      ],
      "finalAnswer": {
        "en": "$x = 2, 3$",
        "ne": "$x = 2, 3$"
